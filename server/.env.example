# Server & Database Configuration
MONGO_URI=mongodb://localhost:27017/saathi
JWT_SECRET=saathi_jwt_secret_change_in_production
PORT=5001
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Super Administrator Email (Auto-elevated to role: admin upon Google SSO login)
ADMIN_EMAIL=amitmanmode01@gmail.com
COUNSELOR_EMAIL=counselor@mitsgwl.ac.in

# Email Notifications (Nodemailer SMTP)
# If omitted, notifications are logged with status "skipped" and the app runs in fallback mode.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
MAIL_FROM=Saathi Wellness Center <no-reply@saathi.edu>

# SMS Notifications (Twilio / Provider-Agnostic)
# If omitted, SMS notifications are logged with status "skipped".
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Google Meet / Google Calendar API (Optional)
# If omitted, meetingService falls back to manual meet links without error.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
